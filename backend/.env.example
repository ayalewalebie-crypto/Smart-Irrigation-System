# ── Server ────────────────────────────────────────────────
PORT=8000
NODE_ENV=production

# ── MongoDB Atlas ─────────────────────────────────────────
MONGODB_URI=mongodb+srv://<user>:<pass>@cluster.mongodb.net/IRRIGATION

# ── JWT ───────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# ── CORS — set to your Vercel frontend URL ────────────────
FRONTEND_URL=https://your-app.vercel.app

# ── Device API Key ────────────────────────────────────────
DEVICE_API_KEY=your_device_key

# ── Email / SMTP ──────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=Smart Irrigation <noreply@yourdomain.com>
APP_URL=https://your-app.vercel.app

# ── Chapa Payment ─────────────────────────────────────────
CHAPA_SECRET_KEY=CHASECK_TEST-your-key
CHAPA_CALLBACK_URL=https://your-backend.onrender.com/api/payroll/chapa/callback
CHAPA_WEBHOOK_SECRET=your_webhook_secret
